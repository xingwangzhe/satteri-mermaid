---
import { markdownToHtml } from "satteri";
import { mermaidMdast, mermaidHast, supportedDiagrams } from "@xingwangzhe/satteri-mermaid";
import type { ThemePreset } from "@xingwangzhe/satteri-mermaid";
import { diagrams } from "../diagrams";
import "../styles/global.css";

const fence = (source: string) => `\`\`\`mermaid\n${source}\n\`\`\``;
const render = async (source: string, theme: ThemePreset = "default") => {
  const { html } = await markdownToHtml(fence(source), {
    mdastPlugins: [mermaidMdast()],
    hastPlugins: [mermaidHast({ theme })],
  });
  return html;
};
const gallery = await Promise.all(Object.entries(diagrams).map(async ([name, source]) => ({
  name, source, html: await render(source),
})));
const themes: ThemePreset[] = ["default", "base", "dark", "forest", "neutral", "neo", "neo-dark",
  "redux", "redux-dark", "redux-color", "redux-dark-color"];
const themeGallery = await Promise.all(themes.map(async (theme) => ({
  theme, html: await render(diagrams.flowchart, theme),
})));
const catalog = supportedDiagrams();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sätteri Mermaid · Merman 预览</title>
    <meta name="description" content="使用包内置 SVG 样式预览 18 类 Mermaid 图表与 11 个主题。" />
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">@xingwangzhe/satteri-mermaid</p>
        <h1>Merman 图表预览</h1>
        <p>真实调用 Sätteri 0.10.5 与 Merman 0.7.0。以下图表由包在构建时生成，直接使用 SVG 自带的 Mermaid 样式。</p>
        <nav aria-label="页面导航"><a href="#diagrams">18 类图表</a><a href="#themes">11 个主题</a><a href="#catalog">引擎目录</a></nav>
      </header>
      <section id="diagrams" aria-labelledby="diagrams-title">
        <h2 id="diagrams-title">图表效果</h2>
        <p>默认主题；展开源代码可查看实际输入。这里只展示代表性语法。</p>
        <div class="gallery">
          {gallery.map(({ name, source, html }) => (
            <article class="card">
              <h3>{name}</h3>
              <div class="diagram-output" set:html={html} />
              <details><summary>Mermaid 源代码</summary><pre><code>{source}</code></pre></details>
            </article>
          ))}
        </div>
      </section>
      <section id="themes" aria-labelledby="themes-title">
        <h2 id="themes-title">包自带主题</h2>
        <p>同一张流程图分别使用 11 个主题，页面不覆盖 SVG 内部的颜色、字体或线条。</p>
        <div class="gallery themes">
          {themeGallery.map(({ theme, html }) => (
            <article class="card"><h3>{theme}</h3><div class="diagram-output" set:html={html} /></article>
          ))}
        </div>
      </section>
      <section id="catalog" aria-labelledby="catalog-title">
        <h2 id="catalog-title">引擎目录</h2>
        <p>{catalog.join(" · ")}</p>
        <p>目录来自实际原生引擎；目录条目不代表所有 Mermaid 语法都经过验证。</p>
      </section>
      <footer>本地预览 · 静态 SVG · 无 Mermaid 客户端脚本</footer>
    </main>
  </body>
</html>
